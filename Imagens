def caixa(ax, x, y, w, h, facecolor, edgecolor="white", lw=1.4, rounded=False):
    if rounded:
        patch = FancyBboxPatch(
            (x, y),
            w,
            h,
            boxstyle="round,pad=0.004,rounding_size=0.012",
            linewidth=lw,
            edgecolor=edgecolor,
            facecolor=facecolor,
        )
    else:
        patch = Rectangle(
            (x, y),
            w,
            h,
            linewidth=lw,
            edgecolor=edgecolor,
            facecolor=facecolor,
        )
    ax.add_patch(patch)


def texto_central(ax, x, y, w, h, texto, size=12, color="black", weight="normal"):
    ax.text(
        x + w / 2,
        y + h / 2,
        texto,
        ha="center",
        va="center",
        fontsize=size,
        color=color,
        fontweight=weight,
        family="DejaVu Sans",
    )


def texto_bloco(
    ax,
    x,
    y,
    w,
    h,
    texto,
    wrap_chars,
    size=12,
    color="black",
    weight="normal",
    pad_x=0.012,
):
    ax.text(
        x + pad_x,
        y + h / 2,
        fill(texto, wrap_chars),
        ha="left",
        va="center",
        fontsize=size,
        color=color,
        fontweight=weight,
        family="DejaVu Sans",
    )


